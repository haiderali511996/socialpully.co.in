# Copy to .env.local for local development.
# On cPanel, set these as environment variables in "Setup Node.js App"
# (or in a .env.production file in the application root).
#
# NEXT_PUBLIC_* values are baked in at BUILD time. After changing any of them
# you must re-run `npm run build` — restarting the app is not enough.

# Public origin of this deployment. Drives canonical tags, Open Graph URLs,
# the sitemap, robots.txt and the JSON-LD schema.
NEXT_PUBLIC_SITE_URL=https://socialpully.hunainimpex.com

# Base URL of the Django API. Falls back to the Railway deployment when unset.
NEXT_PUBLIC_API_BASE=https://socialpullybackend-production.up.railway.app

# Google Analytics measurement ID. Analytics is skipped entirely when unset.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
