# Copy to .env.local for local development, or .env.production on the server.
#
# NEXT_PUBLIC_* values are baked in at BUILD time. After changing any of them
# you must re-run `npm run build` — restarting the app is not enough.

# Public origin of this deployment. Drives canonical tags, Open Graph URLs,
# the sitemap, robots.txt and the JSON-LD schema.
# Must be the canonical host: apex or www, not both.
NEXT_PUBLIC_SITE_URL=https://socialpully.com

# Base URL of the Django API.
NEXT_PUBLIC_API_BASE=https://api.socialpully.com

# Google Analytics measurement ID. Analytics is skipped entirely when unset.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
