# Copy to .env (or set these in your host's dashboard) and fill in real values.

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Leave unset (or False) in production. Set to True for local development.
DEBUG=False

# Comma separated. Defaults to "*".
ALLOWED_HOSTS=socialpully.co.in,www.socialpully.co.in,socialpullybackend-production.up.railway.app

# Comma separated origins allowed to call the API from a browser.
# Leave empty to allow every origin (the previous behaviour).
CORS_ALLOWED_ORIGINS=https://socialpully.co.in,https://www.socialpully.co.in

# Comma separated origins trusted for CSRF (needed for the Django admin over HTTPS).
CSRF_TRUSTED_ORIGINS=https://socialpullybackend-production.up.railway.app

# Database connection string. Falls back to local SQLite when unset.
#   Railway / Postgres:  postgres://user:pass@host:5432/dbname
#   cPanel / MySQL:      mysql://cpuser_dbuser:pass@localhost:3306/cpuser_dbname
# For MySQL also `pip install PyMySQL` — video_downloader/__init__.py registers
# it as MySQLdb, so no compiler is needed.
DATABASE_URL=

# Optional. Enables a shared cache for the TikTok direct-URL lookups,
# which is required if you ever run more than one gunicorn worker.
REDIS_URL=
