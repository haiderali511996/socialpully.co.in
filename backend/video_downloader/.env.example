# Copy to .env (or set these in your host's dashboard) and fill in real values.
# passenger_wsgi.py loads this file at startup; real environment variables
# take precedence over it.

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Leave unset (or False) in production. Set to True for local development.
DEBUG=False

# Comma separated. Defaults to "*".
ALLOWED_HOSTS=api.socialpully.com

# Comma separated origins allowed to call the API from a browser.
# Leave empty to allow every origin (the previous behaviour).
# Only the canonical host is needed — www 301-redirects to the apex, so the
# browser never sends an Origin of https://www.socialpully.com.
CORS_ALLOWED_ORIGINS=https://socialpully.com

# Comma separated origins trusted for CSRF (needed for the Django admin over HTTPS).
CSRF_TRUSTED_ORIGINS=https://api.socialpully.com

# Database connection string. Falls back to local SQLite when unset.
#   Railway / Postgres:  postgres://user:pass@host:5432/dbname
#   cPanel / MySQL:      mysql://cpuser_dbuser:pass@localhost:3306/cpuser_dbname
# For MySQL also `pip install PyMySQL` — video_downloader/__init__.py registers
# it as MySQLdb, so no compiler is needed.
DATABASE_URL=

# Optional. Enables a shared cache for the TikTok direct-URL lookups,
# which is required if you ever run more than one gunicorn worker.
REDIS_URL=

# Optional path to a Netscape-format cookies file, exported from a browser
# logged into a real account. Several platforms (Instagram especially)
# reject most requests without an authenticated session; yt-dlp uses this
# file when present. Defaults to cookies.txt in the project root (next to
# manage.py) — safe to leave unset if you place the file there. Use a
# secondary/throwaway account, not a primary one: this is against the
# platform's ToS for that account and it can get flagged or restricted.
YTDLP_COOKIES_FILE=

# Optional proxy URL (e.g. http://user:pass@host:port), used only for
# YouTube requests. Leave unset unless YouTube is confirmed to be blocking
# this server's IP (see diagnose_ytdlp) -- every other platform works
# without it. A residential proxy is needed; datacenter IPs (including a
# second one from the same host) tend to be blocked the same way.
YTDLP_PROXY_URL=
